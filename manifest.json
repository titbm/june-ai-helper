{
  "manifest_version": 3,
  "name": "JuneAI Helper",
  "version": "1.2.0",
  "description": "Автоматическая отправка запросов в June AI",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://askjune.ai/*", "https://*.vercel.app/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "64": "icons/icon64.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png",
    "256": "icons/icon256.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://askjune.ai/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
